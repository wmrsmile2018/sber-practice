{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "shared/*": ["src/1-shared/*"],
      "entities/*": ["./src/2-entities/*"],
      "features/*": ["./src/3-features/*"],
      "widgets/*": ["./src/4-widgets/*"],
      "pages/*": ["./src/5-pages/*"],
      "app/*": ["./src/6-app/*"]
    }
  },
  "include": ["src/**/*"]
}
